# Copy this file to .env.local. Never commit real keys.
# 请复制为 .env.local，真实密钥不要提交到 Git。

# Supabase: multiplayer, storage and shared API rate limits.
# 单人 AI 接龙和生成语音也使用 Supabase 共享限流。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DeepSeek: solo story continuation and optional commentary (server only).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# VUI: generated Chinese speech (server only).
VUILABS_API_KEY=
VUILABS_API_BASE_URL=https://api.vuilabs.cn

# Optional legacy Fish Audio adapter; not required for the current game.
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free
